Cell[CellGroupData[{

Cell[TextData[{
 "Mean squared displacement ",
 Cell[BoxData[
  FormBox[
   RowBox[{"<", 
    SuperscriptBox[
     SubscriptBox["X", "t"], "2"], ">"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "075eaa98-46fa-f343-b3c9-88fe06d1bdac"],
 " from the moments formula"
}], "Section",
 CellChangeTimes->{{3.9791332258413467`*^9, 
  3.979133239314062*^9}},ExpressionUUID->"5d539388-86e2-1141-95a6-\
d97cd9375f7d"],

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"\[Mu]", ",", "k", ",", "\[Gamma]", ",", "m"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"w", "[", "s_", "]"}], ":=", 
   RowBox[{
    SuperscriptBox["\[Mu]", "k"], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"s", "+", "\[Mu]"}], ")"}], 
     RowBox[{"-", "k"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]", "[", "s_", "]"}], ":=", 
   FractionBox[
    RowBox[{"w", "[", "s", "]"}], 
    RowBox[{"1", "-", 
     RowBox[{"w", "[", "s", "]"}]}]]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.979133258596346*^9, 3.979133260600254*^9}, {
  3.9791333053478336`*^9, 3.979133326963955*^9}, {3.979133845681423*^9, 
  3.9791338569250298`*^9}, {3.9791339110659447`*^9, 3.9791339117278767`*^9}},
 CellLabel->"In[27]:=",ExpressionUUID->"e0238e85-aaf9-9e45-ba39-4d6e54512f1b"],

Cell["We choose \[Lambda]=1.", "Text",
 CellChangeTimes->{{3.9791333598605347`*^9, 
  3.9791333630566406`*^9}},ExpressionUUID->"bc306907-84d9-0f43-a8de-\
f4e3b966ef5a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"xmomentlaplace", "[", 
    RowBox[{"s_", ",", "n_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Psi]", "[", "s", "]"}], 
    FractionBox[
     RowBox[{"n", "!"}], 
     RowBox[{"s", "+", 
      RowBox[{"n", " ", "\[Gamma]"}]}]], 
    RowBox[{"Product", "[", 
     RowBox[{
      RowBox[{"1", "+", 
       RowBox[{"\[Psi]", "[", 
        RowBox[{"s", "+", 
         RowBox[{"m", " ", "\[Gamma]"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"m", ",", "1", ",", 
        RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xmomentlaplace", "[", 
   RowBox[{"s", ",", "2"}], "]"}], "//", 
  "FullSimplify"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.979133335283144*^9, 3.9791333929869804`*^9}, {
  3.979133425970726*^9, 3.9791334427318554`*^9}, {3.9791334797719345`*^9, 
  3.979133526596197*^9}, {3.9791336631100254`*^9, 3.979133701906986*^9}, {
  3.9791338754209633`*^9, 3.979133909263548*^9}, {3.9791339431267414`*^9, 
  3.9791339439020348`*^9}, {3.979134295615879*^9, 3.979134318815033*^9}},
 CellLabel->"In[41]:=",ExpressionUUID->"e278e776-6873-b446-9a8c-daec73510fdc"],

Cell[BoxData[
 FractionBox[
  RowBox[{"2", " ", 
   SuperscriptBox["\[Mu]", "k"], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"s", "+", "\[Gamma]", "+", "\[Mu]"}], ")"}], "k"]}], 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"s", "+", 
     RowBox[{"2", " ", "\[Gamma]"}]}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["\[Mu]", "k"], "-", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"s", "+", "\[Mu]"}], ")"}], "k"]}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["\[Mu]", "k"], "-", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"s", "+", "\[Gamma]", "+", "\[Mu]"}], ")"}], "k"]}], 
    ")"}]}]]], "Output",
 CellChangeTimes->{3.9791343325931797`*^9},
 CellLabel->"Out[42]=",ExpressionUUID->"0382f5a9-35c7-2a40-ab84-060b2418ac7e"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"xmoment2", "[", "t_", "]"}], ":=", 
    RowBox[{"InverseLaplaceTransform", "[", 
     RowBox[{
      RowBox[{"xmomentlaplace", "[", 
       RowBox[{"s", ",", "2"}], "]"}], ",", "s", ",", "t"}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Mu]", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Gamma]", "=", "0.5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"k", "=", "1.5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"xmoment2", "[", "1.3", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9791334654047966`*^9, 3.979133476453726*^9}, {

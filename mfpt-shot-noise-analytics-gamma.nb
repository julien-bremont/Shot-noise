Cell[CellGroupData[{
Cell["\<\
Explicit analytical continuation for Gamma distributed interarrivals\
\>", "Section",
 CellChangeTimes->{{3.9791332030130615`*^9, 
  3.97913321208407*^9}},ExpressionUUID->"1307f80b-b368-e346-8007-\
dbbfb01ba4fc"],

Cell[BoxData[
 RowBox[{"Clear", "[", "k", "]"}]], "Input",
 CellChangeTimes->{{3.979133288581867*^9, 3.9791332906117096`*^9}},
 CellLabel->
  "In[360]:=",ExpressionUUID->"759fb4a4-0367-314b-895d-3047e4bd7506"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"LaplaceTransform", "[", 
  RowBox[{
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"\[Mu]", " ", "t"}], ")"}], 
     RowBox[{"k", "-", "1"}]], 
    FractionBox["\[Mu]", 
     RowBox[{"Gamma", "[", "k", "]"}]], 
    SuperscriptBox["E", 
     RowBox[{
      RowBox[{"-", "\[Mu]"}], " ", "t"}]]}], ",", "t", ",", "s"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.979129042542042*^9, 3.9791290590741463`*^9}, {
  3.979133270628271*^9, 3.9791332974221478`*^9}},
 CellLabel->
  "In[362]:=",ExpressionUUID->"97e8f17d-7cc7-414d-8dbc-5b85f78903fa"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["\[Mu]", "k"], " ", 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"s", "+", "\[Mu]"}], ")"}], 
   RowBox[{"-", "k"}]]}]], "Output",
 CellChangeTimes->{
  3.979129060483055*^9, {3.979133285523632*^9, 3.9791332982850914`*^9}},
 CellLabel->
  "Out[362]=",ExpressionUUID->"6d953237-9b0e-1a4b-99a8-5c3c91df3694"]
}, Open  ]],

Cell["n=\[Lambda] b, a=\[Gamma]/\[Mu] where \[Mu]=rate of the Gamma dist.", \
"Text",
 CellChangeTimes->{{3.979131419782284*^9, 
  3.9791314404057465`*^9}},ExpressionUUID->"5b734811-0b29-804e-b2ff-\
aff92fe1c23b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"testsum", "[", 
   RowBox[{"a_", ",", "n_", ",", "k_"}], "]"}], ":=", 
  RowBox[{"Exp", "[", 
   RowBox[{"-", 
    RowBox[{"NSum", "[", 
     RowBox[{
      RowBox[{
       FractionBox["1", 
        RowBox[{"m", " ", 
         SuperscriptBox["a", 
          RowBox[{"k", " ", "m"}]]}]], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Zeta", "[", 
          RowBox[{
           RowBox[{"k", " ", "m"}], ",", 
           RowBox[{"1", "+", 
            FractionBox["1", "a"]}]}], "]"}], "-", 
         RowBox[{"Zeta", "[", 
          RowBox[{
           RowBox[{"k", " ", "m"}], ",", 
           RowBox[{"n", "+", "1", "+", 
            FractionBox["1", "a"]}]}], "]"}]}], ")"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"m", ",", "1", ",", "100"}], "}"}], ",", 
      RowBox[{"Method", "->", "\"\<WynnEpsilon\>\""}]}], "]"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{"a_", ",", "n_", ",", "k_"}], "]"}], ":=", 
  RowBox[{"Product", "[", 
   RowBox[{
    RowBox[{"1", "-", 
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox["1", 
        RowBox[{
         RowBox[{"m", " ", "a"}], "+", "1"}]], ")"}], "k"]}], ",", 
    RowBox[{"{", 
     RowBox[{"m", ",", "1", ",", "n"}], "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.979130547558611*^9, 3.9791306160177593`*^9}, {
  3.9791309999299793`*^9, 3.979131003748827*^9}, {3.9791310381858845`*^9, 
  3.97913107362805*^9}, {3.979131655780157*^9, 3.979131721488394*^9}, {
  3.979131857775276*^9, 3.9791318682231045`*^9}, {3.979131931389164*^9, 
  3.979131933786976*^9}},
 CellLabel->
  "In[336]:=",ExpressionUUID->"fb086a0a-d1fa-3d48-bf7e-e766c1b755cc"],


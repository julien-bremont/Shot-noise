Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{"LaplaceTransform", "[", 
  RowBox[{
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"\[Lambda]", " ", "t"}], ")"}], 
     RowBox[{"k", "-", "1"}]], 
    FractionBox["\[Lambda]", 
     RowBox[{"Gamma", "[", "k", "]"}]], 
    SuperscriptBox["E", 
     RowBox[{
      RowBox[{"-", "\[Lambda]"}], " ", "t"}]]}], ",", "t", ",", "s"}], 
  "]"}]], "Input",

Cell["n=\[Lambda] b, a=\[Gamma]/\[Mu] where \[Mu]=rate of the Gamma dist.", \
"Text",
 CellChangeTimes->{{3.979131419782284*^9, 
  3.9791314404057465`*^9}},ExpressionUUID->"5b734811-0b29-804e-b2ff-\
aff92fe1c23b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"testsum", "[", 
   RowBox[{"a_", ",", "n_", ",", "k_"}], "]"}], ":=", 
  RowBox[{"Exp", "[", 
   RowBox[{"-", 
    RowBox[{"NSum", "[", 
     RowBox[{
      RowBox[{
       FractionBox["1", 
        RowBox[{"m", " ", 
         SuperscriptBox["a", 
          RowBox[{"k", " ", "m"}]]}]], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Zeta", "[", 
          RowBox[{
           RowBox[{"k", " ", "m"}], ",", 
           RowBox[{"1", "+", 
            FractionBox["1", "a"]}]}], "]"}], "-", 
         RowBox[{"Zeta", "[", 
          RowBox[{
           RowBox[{"k", " ", "m"}], ",", 
           RowBox[{"n", "+", "1", "+", 
            FractionBox["1", "a"]}]}], "]"}]}], ")"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"m", ",", "1", ",", "100"}], "}"}], ",", 
      RowBox[{"Method", "->", "\"\<WynnEpsilon\>\""}]}], "]"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{"a_", ",", "n_", ",", "k_"}], "]"}], ":=", 
  RowBox[{"Product", "[", 
   RowBox[{
    RowBox[{"1", "-", 
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox["1", 
        RowBox[{
         RowBox[{"m", " ", "a"}], "+", "1"}]], ")"}], "k"]}], ",", 
    RowBox[{"{", 
     RowBox[{"m", ",", "1", ",", "n"}], "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.979130547558611*^9, 3.9791306160177593`*^9}, {
  3.9791309999299793`*^9, 3.979131003748827*^9}, {3.9791310381858845`*^9, 
